# Copia este archivo a ".env" para desarrollo local. NUNCA subas el .env real.
# En GitHub Pages estos valores se definen en: Settings > Secrets and variables > Actions > Variables
# Solo la URL y la clave PÚBLICA "anon". JAMÁS la clave service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_publica_anon
VITE_SUPABASE_BUCKET=fotografias
# Solo si tu plan de Supabase incluye transformación de imágenes (WebP y redimensionado):
VITE_SUPABASE_TRANSFORM=false
